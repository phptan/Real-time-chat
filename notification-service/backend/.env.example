APP_NAME=notification-service
ENV=dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/notification_db
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
REDIS_URL=redis://redis:6379/0
REDIS_CHANNELS=new_message,message_deleted,user_registered,password_reset,friend_request,friend_accepted
FCM_CREDENTIALS_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
AUTH_PG_DUMP_URL=postgresql://postgres:postgres@postgres:5432/notification_db
CHAT_MONGO_URI=mongodb://mongo:27017/chat_db
CHAT_MONGO_DB_NAME=chat_db
BACKUP_BUCKET=backups
BACKUP_KEEP_LAST=30
BACKUP_CRON_HOUR=2
BACKUP_CRON_MINUTE=0
BACKUP_TIMEZONE=UTC
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
